# Which backend the conversation manager should use: "memory" or "postgres"
STORAGE_MODE=memory

# --- Memory store settings (only used when STORAGE_MODE=memory) ---
# How long an idle conversation is kept before it's evicted, in milliseconds.
# Default: 30 minutes.
MEMORY_TTL_MS=1800000

# --- Postgres settings (only used when STORAGE_MODE=postgres) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=conversations
PGUSER=postgres
PGPASSWORD=changeme
# Alternatively, set a single connection string and it takes precedence
# over the discrete PG* vars above:
# DATABASE_URL=postgresql://user:password@localhost:5432/conversations
PGSSL=false
